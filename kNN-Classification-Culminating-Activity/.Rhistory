studF <- data.frame(
StudyHours =c(7.2,16.2, 9.4, 17.9,18.9, 2.8),
AttendanceRate = c(84.0, 73.3, 79.5, 98.2, 79.3, 95.6),
Gender = c("Female","Female","Female","Male","Female","Female"),
SchoolType = c("Private","Private","Public","Private","Public","Public"),
ScienceScore = c(102.2, 117.1, 89.0, 121.9, 112.0,  76.3)
)
library(plotly)
library(ggplot2)
studF <- data.frame(
StudyHours =c(7.2,16.2, 9.4, 17.9,18.9, 2.8),
AttendanceRate = c(84.0, 73.3, 79.5, 98.2, 79.3, 95.6),
Gender = c("Female","Female","Female","Male","Female","Female"),
SchoolType = c("Private","Private","Public","Private","Public","Public"),
ScienceScore = c(102.2, 117.1, 89.0, 121.9, 112.0,  76.3)
)
set.seed(31)
n <- 100
data <- data.frame(
StudyHours = round(runif(n, 2, 20), 1),
AttendanceRate = round(runif(n, 60, 100), 1),
Gender = factor(sample(c("Male", "Female"), n,
replace = TRUE)),
SchoolType = factor(sample(c("Public", "Private"),
n, replace = TRUE))
)
# Generate Science Score with some realistic relationship
data$ScienceScore <- round(
40 +
2.5 * data$StudyHours +
0.3 * data$AttendanceRate +
ifelse(data$Gender == "Female", 3, 0) +
ifelse(data$SchoolType == "Private", 5, 0) +
rnorm(n, 0, 5),
1
)
model <- lm(ScienceScore ~ ., data = data)
summary(model)
coef(model)
summary(model)
install.packages(c("dplyr", "tidyverse", "tidyr", "corrplot", "plotly"))
install.packages(c("ggplot2", "plotly", "dplyr", "tidyr", "corrplot", "leaflet"))
install.packages(c("gridExtra", "tidyverse", "cluster", "factoextra", "magrittr", "ggplot2", "dbscan", "fpc", "arules"))
install.packages(c("caret", "class", "rpart", "rpart.plot", "shiny", "plotly", "ggplot2"))
install.packages("lmtest")
install.packages("CAR")
install.packages("car")
clear
library(plotly)
library(ggplot2)
studF <- data.frame(
StudyHours =c(7.2,16.2, 9.4, 17.9,18.9, 2.8),
AttendanceRate = c(84.0, 73.3, 79.5, 98.2, 79.3, 95.6),
Gender = c("Female","Female","Female","Male","Female","Female"),
SchoolType = c("Private","Private","Public","Private","Public","Public"),
ScienceScore = c(102.2, 117.1, 89.0, 121.9, 112.0,  76.3)
)
set.seed(31)
n <- 100
data <- data.frame(
StudyHours = round(runif(n, 2, 20), 1),
AttendanceRate = round(runif(n, 60, 100), 1),
Gender = factor(sample(c("Male", "Female"), n,
replace = TRUE)),
SchoolType = factor(sample(c("Public", "Private"),
n, replace = TRUE))
)
# Generate Science Score with some realistic relationship
data$ScienceScore <- round(
40 +
2.5 * data$StudyHours +
0.3 * data$AttendanceRate +
ifelse(data$Gender == "Female", 3, 0) +
ifelse(data$SchoolType == "Private", 5, 0) +
rnorm(n, 0, 5),
1
)
# SETUP
model <- lm(ScienceScore ~ ., data = data)
# DIAGNOSTIC CHECKING
# I. NORMALITY
# GRAPHICAL ANALYSIS OF RESIDUALS
qqnorm (residuals(model), ylab="Residuals")
qqline (residuals(model)) #Normality using Q-Q Plots
# STATISTICAL TEST
length(residuals(model))
# SHAPIRO WALK NORMALITY TEST
shapiro.test(residuals(model))
resid_std <- scale(residuals(model)) # mean=0, sd=1
ks.test(resid_std, "pnorm")
# HOMOSCEDASTICITY
plot(fitted(model), residuals(model))
library("lmtest")
bptest(model)
gqtest(model, order.by = ScienceScore ~., data = data)
# MULTICOLLINEARITY
options(width = 50)
library(car)
vif(model)
# SUMMARY
summary(model)
coef(model)
summary(model)
library(dplyr)
library(ggplot2)
df <- read.csv("ecommerce_dataset.csv")
reg_df <- df %>%
select(Price, Discount, Tax.Rate, Stock.Level,
Shipping.Cost, Return.Rate, Popularity.Index)
model <- lm(Popularity.Index ~ ., data = reg_df)
summary(model)
library(lm.beta)
summary(lm.beta(model))
